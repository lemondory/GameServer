{
  "TokenOptions": {
    "Audience": "GameServer",
    "Issuer": "GameServer",
    "AccessTokenExpiration": 60,
    "RefreshTokenExpiration": 1,
    "SecurityKey": "1a2b3c4d5e6f708090ab12cd34ef5678a9bcde1f2f3f45f67a8d9012ac345678"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ApplicationSettings": {
    "DbConnString": "server=127.0.0.1;database=account;user=root;password=TestUser"
  },
  "ConnectionStrings": {
    "Account": "server=127.0.0.1;database=Account;user=root;password=TestUser",
    "Common": "server=127.0.0.1;database=Common;user=root;password=TestUser"
  },
  "Serilog": {
    // 사용할 Sink (출력 대상) 라이브러리 명시
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File", "Serilog.Sinks.Seq" ],

    // 로그의 기본 레벨 (Information 이상만 기록)
    "MinimumLevel": {
      "Default": "Information", // 전체 로그 기본 레벨
      "Override": {
        "Microsoft": "Warning", // Microsoft 네임스페이스 로그는 Warning 이상만 기록
        "System": "Warning" // System 네임스페이스도 마찬가지
      }
    },

    // 로그에 자동으로 추가될 메타데이터 (Enricher)
    "Enrich": [
      "FromLogContext", // 로그 컨텍스트 정보 (예: 요청 ID 등) 포함
      "WithThreadId" // 쓰레드 ID 포함
    ],

    // 로그마다 자동으로 추가할 속성(프로퍼티) (구조화 로그용)
    "Properties": {
      "Service": "GameServer" // 로그에 항상 포함될 Service 필드
    },

    // 로그 출력 대상들
    "WriteTo": [
      {
        "Name": "Console" // 콘솔로 출력 (개발자 디버깅용)
      },
      {
        "Name": "File", // 파일로 출력
        "Args": {
          "path": "Logs/log-.txt", // 로그 파일 경로 (자동 날짜 추가됨)
          "rollingInterval": "Day", // 날짜별 파일 생성
          "fileSizeLimitBytes": 1000000000, // 1GB 단위로 분할
          "rollOnFileSizeLimit": true, // 파일 크기 초과 시 분할
          "retainedFileCountLimit": 30, // 최대 30개 파일 유지
          "shared": true, // 여러 프로세스가 같은 파일 접근 가능
          "flushToDiskInterval": "00:00:02" // 2초마다 디스크에 기록
        }
      },
      {
        "Name": "Seq", // Seq 서버로 로그 전송
        "Args": {
          "serverUrl": "http://localhost:5341" // Seq 서버 주소
        }
      }
    ]
  }

}
